# Copy to .env (never commit .env)
PORT=3000
MAX_UPLOAD_MB=500

# Optional: smart cuts (repeat takes, tangents) via Claude API.
# Leave empty to use only rule-based cutting.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Caption font. For Hindi/Devanagari install "Noto Sans Devanagari" and set it here.
CAPTION_FONT=Arial
CAPTION_FONT_SIZE=18
